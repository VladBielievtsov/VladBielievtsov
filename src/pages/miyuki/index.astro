---
import Layout from "../../layouts/Layout.astro";

const BOT_TOKEN = import.meta.env.BOT_TOKEN;

const response = await fetch(
  `https://discord.com/api/v10/users/1251560717417582714`,
  {
    headers: {
      Authorization: `Bot ${BOT_TOKEN}`,
    },
  }
);

const data = await response.json();

const avatar = `https://cdn.discordapp.com/avatars/1251560717417582714/${data.avatar}.png?size=512`;
---

<Layout title="miyuki | vlad">
  <div>
    <div class="sm:flex">
      <div>
        <img
          src={avatar}
          alt="Miyuki"
          width="100"
          height="100"
          class="rounded-full"
        />
      </div>
      <div class="sm:pl-4 mt-2 sm:mt-0 flex-1">
        <h2 class="text-xl font-semibold">Miyuki</h2>
        <p>
          Miyuki is a multipurpose Discord bot designed to enhance your server
          experience.
        </p>
        <div class="pt-2">
          <a
            href="https://discord.com/oauth2/authorize?client_id=1251560717417582714&permissions=8&integration_type=0&scope=bot"
            class="btn mr-4 w-full sm:w-auto">Invite Miyuki</a
          >
          <a
            href="https://discord.gg/6AujqPVqyj"
            class="btn w-full sm:w-auto mt-4 sm:mt-0">Support server</a
          >
        </div>
      </div>
    </div>
    <div class="mt-4"><h2 class="text-xl">Commands</h2></div>
    <div class="flex sm:justify-end flex-col sm:flex-row mt-4">
      <a href="/miyuki/terms" class="mr-4 hover:text-mauve">Terms of Service</a>
      <a href="/miyuki/policy" class="hover:text-mauve">Privacy Policy</a>
    </div>
  </div>
</Layout>
