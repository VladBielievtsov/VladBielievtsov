---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = await getCollection("blog");
---

<Layout>
  <h1 class="text-xl mb-4">Blog</h1>
  <ul>
    {
      posts.map((post: any, id: number) => (
        <li>
          <a
            class={`${id % 2 === 0 ? "bg-mauve/15" : "bg-mauve/5"} px-2 py-0.5 flex justify-between items-start hover:bg-mauve hover:text-basee`}
            href={"/blog/" + post.id}
          >
            <span>{post.data.title}</span>
            <span>{post.data.createdAt}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
