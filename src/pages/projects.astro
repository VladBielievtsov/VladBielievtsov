---
import Layout from "../layouts/Layout.astro";

const projects = [
  {
    title: "Miyuki",
    slug: "miyuki",
    langs: "Typescript, Go",
    description: "is a entertainment discord bot",
  },
];
---

<Layout>
  <h1 class="text-xl mb-4">Projects</h1>
  <ul>
    {
      projects.length > 0 ? (
        projects.map((p: any, id: number) => (
          <li>
            <a
              class={`${id % 2 === 0 ? "bg-mauve/15" : "bg-mauve/5"} px-2 py-0.5 flex justify-between items-start hover:bg-mauve hover:text-basee`}
              href={p.slug}
            >
              <span>
                {p.title} {p.description && ` - ${p.description}`}
              </span>

              <span>{p.langs}</span>
            </a>
          </li>
        ))
      ) : (
        <p>No projects</p>
      )
    }
  </ul>
</Layout>
