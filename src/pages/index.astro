---
import Layout from "../layouts/Layout.astro";
import Avatar from "../components/Avatar.astro"
---

<Layout>
  <div>
    <div class="flex">
      <Avatar />
      <div class="pl-4">
        <h2 class="text-xl font-semibold">Hello,</h2>
        <h2 class="text-xl">I'm Vlad</h2>
        <p>
          <i
            class="h-4 w-4 inline-block bg-no-repeat pr-4 bg-center bg-[length:1em] align-[-0.1em] ml-[.1em] mr-[.05em]"
            style="background-image: url('/archlinux.svg');"></i> Arch Linux User
        </p>
      </div>
    </div>
    <div>
      <p class="my-4">
        Hi! I'm 24 yo full-stack developer focused on frontend. I mostly spend
        my time with web development, with Nextjs, Tailwindcss, and Go on
        backend. I also dabble in other things, like discord bots. I try to
        learn new things.
      </p>
      <p class="my-4">
        This website is made using <a
          href="https://astro.build/"
          target="_blank"
          class="text-mauve hover:underline">astro</a
        >, I intend to use this website as a place where I can show my projects
        and write some blogs about what I do in general.
      </p>
      <p class="my-4">
        If you want to contact me, you can do so by sending me a DM on <a
          href="https://discordapp.com/users/416963547747188738"
          target="_blank"
          class="text-mauve hover:underline">Discord</a
        >, and you can also find me on Twitter <a
          href="https://twitter.com/VBelevtsov"
          target="_blank"
          class="text-mauve hover:underline">@VBelevtsov</a
        > and <a
          href="https://github.com/VladBielievtsov"
          target="_blank"
          class="text-mauve hover:underline">Github</a
        >.
      </p>
    </div>
  </div>
</Layout>
