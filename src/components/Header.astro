---
const currectPath = Astro.url.pathname;
---

<div class="border-b border-mauve p-4">
  <div class="flex items-center justify-between">
    <div>
      <a href="/">~/bvlad.com</a>
    </div>
    <div class="flex items-center gap-4">
      <a
        href="/"
        class={`hover:text-mauve ${currectPath === "/" ? "text-mauve" : ""}`}
        >Home</a
      >
      <a
        href="/projects"
        class={`hover:text-mauve ${currectPath === "/projects" ? "text-mauve" : ""}`}
        >Projects</a
      >
      <a
        href="/blog"
        class={`hover:text-mauve ${currectPath === "/blog" ? "text-mauve" : ""}`}
        >Blog</a
      >
    </div>
  </div>
</div>
