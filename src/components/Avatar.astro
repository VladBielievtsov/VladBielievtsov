---
import ky from "ky";

type UserInfo = {
  status: string;
  avatar: string;
};

const domain = new URL(Astro.request.url).origin;
const userInfo: UserInfo = await ky.get(`https://bvlad.com/discord`).json<UserInfo>();

const statusColors = {
  online: "bg-[#a6e3a1]",
  dnd: "bg-[#f38ba8]",
  offline: "bg-[#7f849c]",
};

let status = userInfo.status.toLowerCase();
if (status === "idle") status = "online";

const statusColor = statusColors[status as keyof typeof statusColors];
---


<div class="relative group">
  <img
    src={userInfo.avatar}
    alt="my profile picture"
    width="100"
    height="100"
    class="rounded-full"
    draggable="false"
  />
  <div
    class=`absolute right-0 bottom-0 w-6 h-6 rounded-full flex items-center z-10 bg-mantle group-hover:bg-[#ffffff]`
  >
    <span class="absolute text-base flex group-hover:w-max group-hover:mix-w-fit w-6 rounded-full bg-mantle pr-1 group-hover:bg-[#ffffff]">
      <span class="invisible w-6 h-6 block"></span>
      <span class="invisible text-basee group-hover:visible">{status}</span>
    </span> 
    <span class=`w-4 h-4 ${statusColor} block rounded-full ml-1 z-10`></span>
  </div>
</div>

